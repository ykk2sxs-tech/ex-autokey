{
  "format": "ex-autokey-template",
  "version": 1,
  "name": "ซื้อเงินสด",
  "description": "ซื้อเงินสด 1 เอกสารมีได้หลายรายการ · ตัวอย่างเริ่มต้น: ลำดับช่องและปุ่มต้องปรับให้ตรงกับหน้าจอ Express ของคุณก่อนใช้งานจริง",
  "window_title": "Express",
  "group_by": "เลขที่",
  "settings": {
    "key_delay_ms": 30,
    "step_delay_ms": 150,
    "doc_delay_ms": 1000,
    "start_delay_s": 3,
    "input_mode": "unicode"
  },
  "header": [
    {
      "kind": "field",
      "column": "เลขที่",
      "format": {
        "type": "text"
      },
      "then": "{ENTER}",
      "required": true,
      "note": "เลขที่เอกสาร"
    },
    {
      "kind": "field",
      "column": "วันที่",
      "format": {
        "type": "date",
        "pattern": "dd/mm/yy",
        "era": "BE"
      },
      "then": "{ENTER}",
      "required": true
    },
    {
      "kind": "field",
      "column": "รหัสผู้จำหน่าย",
      "format": {
        "type": "text"
      },
      "then": "{ENTER}",
      "required": true
    }
  ],
  "lines": [
    {
      "kind": "field",
      "column": "รหัสสินค้า",
      "format": {
        "type": "text"
      },
      "then": "{ENTER}",
      "required": true
    },
    {
      "kind": "field",
      "column": "จำนวน",
      "format": {
        "type": "number",
        "decimals": null,
        "total": true
      },
      "then": "{ENTER}",
      "required": true
    },
    {
      "kind": "field",
      "column": "ราคาต่อหน่วย",
      "format": {
        "type": "number",
        "decimals": 2
      },
      "then": "{ENTER}",
      "required": true
    }
  ],
  "footer": [
    {
      "kind": "pause",
      "value": "ตรวจหน้าจอและยอดรวมใน Express แล้วกดบันทึกเอง จากนั้นกด 'ทำต่อ' (ทดสอบผ่านแล้วค่อยเปลี่ยนขั้นตอนนี้เป็นปุ่มบันทึกจริงของ Express)"
    }
  ]
}
