{
  "format": "ex-autokey-template",
  "version": 1,
  "name": "รับชำระหนี้",
  "description": "รับชำระหนี้ 1 ใบเสร็จตัดได้หลายใบกำกับ · ตัวอย่างเริ่มต้น: ลำดับช่องและปุ่มต้องปรับให้ตรงกับหน้าจอ Express ของคุณก่อนใช้งานจริง",
  "window_title": "Express",
  "group_by": "เลขที่ใบเสร็จ",
  "settings": {
    "key_delay_ms": 30,
    "step_delay_ms": 150,
    "doc_delay_ms": 1000,
    "start_delay_s": 3,
    "input_mode": "unicode"
  },
  "header": [
    {
      "kind": "field",
      "column": "เลขที่ใบเสร็จ",
      "format": {
        "type": "text"
      },
      "then": "{ENTER}",
      "required": true
    },
    {
      "kind": "field",
      "column": "วันที่",
      "format": {
        "type": "date",
        "pattern": "dd/mm/yy",
        "era": "BE"
      },
      "then": "{ENTER}",
      "required": true
    },
    {
      "kind": "field",
      "column": "รหัสลูกค้า",
      "format": {
        "type": "text"
      },
      "then": "{ENTER}",
      "required": true
    }
  ],
  "lines": [
    {
      "kind": "field",
      "column": "เลขที่ใบกำกับ",
      "format": {
        "type": "text"
      },
      "then": "{ENTER}",
      "required": true,
      "note": "ใบกำกับที่รับชำระ"
    },
    {
      "kind": "field",
      "column": "ยอดรับชำระ",
      "format": {
        "type": "number",
        "decimals": 2,
        "total": true
      },
      "then": "{ENTER}",
      "required": true
    }
  ],
  "footer": [
    {
      "kind": "pause",
      "value": "เลือกวิธีรับเงิน (เงินสด/เช็ค/โอน) ตรวจยอดแล้วกดบันทึกใน Express เอง จากนั้นกด 'ทำต่อ'"
    }
  ]
}
